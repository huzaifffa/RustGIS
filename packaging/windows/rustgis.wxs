<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer package (WiX 5), built by package.sh. An all-users install in Program Files:
  a Start menu shortcut, rustgis-cli on the system PATH, .rgis/.rgisx projects opened by RustGIS
  and RustGIS offered under Open with for .geojson. Variables passed with -d: Version (three
  numbers), Stage (the folder holding the exes, LICENSE and
  THIRD-PARTY-LICENSES.txt), Icon, License (RTF), Banner and
  Dialog (BMPs).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The UpgradeCode never changes: a new version replaces the installed one. -->
  <Package Name="RustGIS" Manufacturer="Open Geospatial Solutions" Version="$(var.Version)"
    UpgradeCode="B8624035-B7AF-41E7-BCAC-7C59DE885053" Scope="perMachine" Language="1033">
    <!-- Same-version upgrades too: a pre-release (0.2.0-rc.1) and its release share 0.2.0. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of RustGIS is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="rustgis.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="rustgis.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://rustgis.app" />
    <Property Id="ARPHELPLINK" Value="https://github.com/opengeos/RustGIS/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RustGIS" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="RustGIS">
      <Component Directory="INSTALLFOLDER">
        <File Id="rustgis.exe" Source="$(var.Stage)\rustgis.exe" KeyPath="yes" />
        <ProgId Id="RustGIS.Project" Description="RustGIS project" Icon="rustgis.exe" IconIndex="0">
          <Extension Id="rgis">
            <Verb Id="open" TargetFile="rustgis.exe" Argument="&quot;%1&quot;" />
          </Extension>
          <!-- The verb is the ProgId's (RustGIS.Project\shell\open): one serves both. -->
          <Extension Id="rgisx" />
        </ProgId>
        <!-- Listed under Open with for GeoJSON, without taking over the default app. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.geojson\OpenWithProgids" Name="RustGIS.Project"
          Type="string" Value="" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="rustgis_cli.exe" Source="$(var.Stage)\rustgis-cli.exe" KeyPath="yes" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set"
          System="yes" Permanent="no" />
      </Component>
      <!-- A shortcut needs a registry key path (ICE43). -->
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="RustGIS" Description="Desktop GIS with a ribbon workflow"
          Target="[#rustgis.exe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RustGIS" Name="StartMenuShortcut" Type="integer" Value="1"
          KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="LICENSE" Source="$(var.Stage)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="THIRDPARTY" Source="$(var.Stage)\THIRD-PARTY-LICENSES.txt" KeyPath="yes" />
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Banner)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Dialog)" />
  </Package>
</Wix>
