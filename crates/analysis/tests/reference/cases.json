     [
      "P6",
      "Z1"
     ],
     [
      "P7",
      null
     ],
     [
      "P8",
      "Z5"
     ]
    ]
   }
  },
  {
   "name": "join contains",
   "tool": "spatialJoin",
   "params": {
    "target": "parcels",
    "join": "points",
