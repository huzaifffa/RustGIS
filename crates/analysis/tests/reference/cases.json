{
 "about": "Answers from GEOS; regenerate with `uv run generate.py` (see its header).",
 "shapely": "2.1.2",
 "geos": "3.13.1",
 "pyproj": "3.7.2",
 "proj": "9.5.1",
 "cases": [
  {
   "name": "clip polygons",
   "tool": "clip",
   "params": {
    "input": "parcels",
    "clip": "zones"
   },
   "expect": {
    "features": "expected/clip_parcels.geojson"
   }
  },
  {
   "name": "clip lines",
   "tool": "clip",
   "params": {
    "input": "roads",
    "clip": "zones"
   },
   "expect": {
    "features": "expected/clip_roads.geojson"
   }
  },
  {
   "name": "clip points",
   "tool": "clip",
   "params": {
    "input": "points",
    "clip": "zones"
   },
   "expect": {
    "ids": [
     "b",
     "d",
     "e",
     "j"
    ]
   }
  },
  {
   "name": "erase",
   "tool": "erase",
   "params": {
    "input": "parcels",
    "erase": "zones"
   },
   "expect": {
    "features": "expected/erase_parcels.geojson"
   }
  },
  {
   "name": "dissolve by field",
   "tool": "dissolve",
   "params": {
    "input": "parcels",
    "field": "code"
   },
   "expect": {
    "features": "expected/dissolve_code.geojson",
    "key": "code",
    "counts": {
     "A": 3,
     "B": 2,
     "C": 2,
     "D": 1
    }
   }
  },
  {
   "name": "dissolve all",
   "tool": "dissolve",
   "params": {
    "input": "parcels"
   },
   "expect": {
    "features": "expected/dissolve_all.geojson",
    "key": null
   }
  },
  {
   "name": "convex hull of each",
   "tool": "convexHull",
   "params": {
    "input": "parcels",
    "group": "None"
   },
   "expect": {
    "features": "expected/hull_each.geojson"
   }
  },
  {
   "name": "convex hull of all",
   "tool": "convexHull",
   "params": {
    "input": "parcels",
    "group": "All"
   },
   "expect": {
    "features": "expected/hull_all.geojson",
    "key": null
   }
  },
  {
   "name": "select parcels by zones",
   "tool": "selectByLocation",
   "params": {
    "input": "parcels",
    "select": "zones"
   },
   "expect": {
    "ids": [
     "P1",
     "P2",
     "P3",
     "P4",
     "P6",
     "P8"
    ]
   }
  },
  {
   "name": "select parcels by zones, inverted",
   "tool": "selectByLocation",
   "params": {
    "input": "parcels",
    "select": "zones",
    "invert": "Yes"
   },
   "expect": {
    "ids": [
     "P5",
     "P7"
    ]
   }
  },
  {
   "name": "select roads by parcels",
   "tool": "selectByLocation",
   "params": {
    "input": "roads",
    "select": "parcels"
   },
   "expect": {
    "ids": [
     "r1",
     "r2",
     "r4",
     "r6"
    ]
   }
  },
  {
   "name": "select points by parcels",
   "tool": "selectByLocation",
   "params": {
    "input": "points",
    "select": "parcels"
   },
   "expect": {
    "ids": [
     "a",
     "b",
     "c",
     "e",
     "g",
     "h",
     "i",
     "j"
    ]
   }
  },
  {
   "name": "select roads by zones",
   "tool": "selectByLocation",
   "params": {
    "input": "roads",
    "select": "zones"
   },
   "expect": {
    "ids": [
     "r1",
     "r2",
     "r3",
     "r6"
    ]
   }
  },
  {
   "name": "summarize within",
   "tool": "countPoints",
   "params": {
    "polygons": "parcels",
    "points": "points"
   },
   "expect": {
    "field": "point_count",
    "values": {
     "P1": 3,
     "P2": 2,
     "P3": 2,
     "P4": 0,
     "P5": 2,
     "P6": 1,
     "P7": 1,
     "P8": 1
    }
   }
  },
  {
   "name": "join intersects",
   "tool": "spatialJoin",
   "params": {
    "target": "parcels",
    "join": "zones",
    "match": "Intersects",
    "operation": "Join one to many"
   },
   "expect": {
    "pairs": [
